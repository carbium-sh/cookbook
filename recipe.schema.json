{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A cookbook recipe",
  "description": "recipe.json in <service>/<recipe>/. One folder per language sits beside it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "service", "calls", "env", "languages", "expect"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "summary": { "description": "One line for the index.", "type": "string", "minLength": 1, "maxLength": 120 },
    "service": { "enum": ["rpc", "das", "websocket", "stream", "quote", "swap", "prices", "health", "webhooks", "account", "dca", "tokens"] },
    "calls": { "description": "Every call the example makes, in order, repeats included, when every page it reads is full. Names as spec/served.json lists them; a subscription's unsubscribe too.", "type": "array", "items": { "type": "string" } },
    "env": { "description": "The key variables the recipe reads.", "type": "array", "items": { "enum": ["CARBIUM_KEY", "CARBIUM_ACCOUNT_KEY", "CARBIUM_WEBHOOK_SECRET"] }, "uniqueItems": true },
    "languages": { "description": "The language folders present.", "type": "array", "minItems": 1, "items": { "enum": ["typescript", "python", "rust", "go"] }, "uniqueItems": true },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": { "description": "Keys the last line of output must hold.", "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "unsigned": { "description": "The output's transaction must be unsigned, with userPubkey as its fee payer.", "const": true }
      }
    }
  }
}
