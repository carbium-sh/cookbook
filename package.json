{
  "name": "carbium-cookbook",
  "version": "0.1.0",
  "private": true,
  "description": "Small examples that call Carbium's Solana services, one folder per task and language",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "typecheck": "tsc -p tsconfig.json",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install --quiet 'carbium>=0.1,<0.2'",
    "index": "node scripts/index.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "ws": "8.23.0"
  }
}
