# Whitelist: everything is ignored unless allowed below.
/*
!/.gitignore
!/.github/
!/hooks/
!/scripts/
!/LICENSE
!/README.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/recipe.schema.json
!/tsconfig.json
!/Cargo.toml
!/Cargo.lock
!/go.work
!/spec/
!/test/
# One folder per service.
!/rpc/
!/das/
!/websocket/
!/quote/
!/swap/
!/prices/
!/webhooks/

# Denies last (they win over the allows above).
node_modules/
.env*
*.env
*.key
*secret*
*keypair*
*.local.*
# npm install in an example writes one; this repo pins with pnpm-lock.yaml.
package-lock.json
__pycache__/
.venv/
# go build -o example . in a Go recipe folder, as its README says.
/*/*/go/example
